{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"scripts/model-catalog-protocol.ts",
			"scripts/model-catalog-protocol.test.ts",
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/agent/examples/**/*.ts",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules"
		]
	},
	"overrides": [
		{
			"includes": [
				"packages/coding-agent/src/tau/**/*.ts",
				"packages/coding-agent/src/**/tau-*.ts",
				"packages/coding-agent/src/core/pi-import/**/*.ts",
				"packages/coding-agent/src/core/isolation/**/*.ts",
				"packages/coding-agent/src/bun/isolation-guard.ts",
				"packages/coding-agent/src/cli/pi-import.ts",
				"packages/coding-agent/test/pi-import-*.test.ts",
				"packages/coding-agent/test/**/tau-*.test.ts",
				"packages/coding-agent/test/fixtures/tau-compat/**/*.ts",
				"scripts/tau-*.ts"
			],
			"linter": { "rules": { "suspicious": { "noExplicitAny": "error" } } }
		}
	],
	"plugins": ["./scripts/biome/model-type-comparison.grit"]
}
